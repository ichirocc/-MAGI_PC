<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9→デザイントークン] Kotlin原本 MainActivity.kt の `MagiTheme`（D8決定「外観は UD
      モードのみ」により実際に出荷されるのは mode=3=高コントラスト配色のみ）と MagiTokens.kt の
      色ロールを、WinUI3 のリソースキーへ移植する。

      [スコープ] Compose の Material3 ColorScheme（30ロール超・Typography・Shapes・WCAGコントラスト
      ヘルパー）の全面移植ではなく、①ブランド色を再利用できる名前付きブラシとして定義し、
      ②WinUI3 の既定チュームが参照する SystemAccentColor 系キーを上書きして、既定スタイルの
      ボタン/トグル/選択状態などがブランド色（ディープティール）で描かれるようにする、の2点に絞る
      （余白段階・角丸段階・タイポグラフィスケールの移植は今後の段階）。

      [Light1-3/Dark1-3 について] Compose 側に対応物が無い（Material3 は独自のトーナルパレット生成を
      使う）ため、SystemAccentColor を白/黒へ単純に加重ブレンドした近似値（15/30/45%）を置く。
      正確な M3 トーナルパレットとの厳密な一致は主張しない——ホバー/押下状態が「それらしい」濃淡に
      なることが目的（WinUI3 既定スタイルがこれらのキーの存在を前提にしているため）。

      [余白・角丸・タイポグラフィスケール] 上記コメントで「今後の段階」としていた3スケールをここで
      移植する。余白＝Kotlin原本 MagiTokens.kt の MagiSpacing（dp→epx、WinUI は 1px=1epx@100%）、
      角丸＝MainActivity.kt の MagiTheme 内 Shapes()（extraSmall/small/medium/large の4段）、
      タイポ＝同ファイル Typography(t) のスケール（sp→pt、WinUI3 TextBlock は既定 Segoe UI Variable）。
      Views/*.xaml.cs は x:Bind を使わずコードビハインドで UI を組み立てるため、Thickness/CornerRadius
      の生成箇所からは `(double)Application.Current.Resources["MagiSpacingMD"]` のように、TextBlock の
      フォントは `(Style)Application.Current.Resources["MagiBodyMediumTextStyle"]` を Style へ代入して
      参照する想定（既存 Views の手書きリテラルの置換は本コミットの対象外＝複数エージェント並行作業に
      よる同一ファイル競合を避けるため、トークン定義のみここへ追加する）。
    -->
    <!-- ===== ブランド色（Kotlin原本 MagiTheme mode=3=高コントラスト、唯一の出荷配色） ===== -->
    <Color x:Key="MagiPrimaryColor">#FF00504A</Color>
    <Color x:Key="MagiOnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="MagiPrimaryContainerColor">#FF003732</Color>
    <Color x:Key="MagiOnPrimaryContainerColor">#FFFFFFFF</Color>
    <Color x:Key="MagiSecondaryColor">#FF123E38</Color>
    <Color x:Key="MagiSecondaryContainerColor">#FFCDE8E3</Color>
    <Color x:Key="MagiOnSecondaryContainerColor">#FF05201C</Color>
    <Color x:Key="MagiTertiaryColor">#FF1C5030</Color>
    <Color x:Key="MagiTertiaryContainerColor">#FFBFF0AF</Color>
    <Color x:Key="MagiOnTertiaryContainerColor">#FF002200</Color>
    <Color x:Key="MagiBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="MagiOnBackgroundColor">#FF000000</Color>
    <Color x:Key="MagiSurfaceVariantColor">#FFE3EDEA</Color>
    <Color x:Key="MagiOnSurfaceVariantColor">#FF16221F</Color>
    <Color x:Key="MagiErrorColor">#FF8C0009</Color>
    <Color x:Key="MagiOnErrorColor">#FFFFFFFF</Color>
    <Color x:Key="MagiErrorContainerColor">#FFFFDAD4</Color>
    <Color x:Key="MagiOnErrorContainerColor">#FF2D0001</Color>
    <Color x:Key="MagiOutlineColor">#FF000000</Color>
    <!-- 警告（黄）: Kotlin原本 MagiTokens.kt の magiWarnColors（明テーマ側）。UD 固定なので暗側は持たない。 -->
    <Color x:Key="MagiWarnContainerColor">#FFFBEAD0</Color>
    <Color x:Key="MagiOnWarnContainerColor">#FF6B4E00</Color>

    <SolidColorBrush x:Key="MagiPrimaryBrush" Color="{StaticResource MagiPrimaryColor}" />
    <SolidColorBrush x:Key="MagiOnPrimaryBrush" Color="{StaticResource MagiOnPrimaryColor}" />
    <SolidColorBrush x:Key="MagiPrimaryContainerBrush" Color="{StaticResource MagiPrimaryContainerColor}" />
    <SolidColorBrush x:Key="MagiSecondaryBrush" Color="{StaticResource MagiSecondaryColor}" />
    <SolidColorBrush x:Key="MagiSecondaryContainerBrush" Color="{StaticResource MagiSecondaryContainerColor}" />
    <SolidColorBrush x:Key="MagiTertiaryBrush" Color="{StaticResource MagiTertiaryColor}" />
    <SolidColorBrush x:Key="MagiTertiaryContainerBrush" Color="{StaticResource MagiTertiaryContainerColor}" />
    <SolidColorBrush x:Key="MagiBackgroundBrush" Color="{StaticResource MagiBackgroundColor}" />
    <SolidColorBrush x:Key="MagiOnBackgroundBrush" Color="{StaticResource MagiOnBackgroundColor}" />
    <SolidColorBrush x:Key="MagiSurfaceVariantBrush" Color="{StaticResource MagiSurfaceVariantColor}" />
    <SolidColorBrush x:Key="MagiErrorBrush" Color="{StaticResource MagiErrorColor}" />
    <SolidColorBrush x:Key="MagiErrorContainerBrush" Color="{StaticResource MagiErrorContainerColor}" />
    <SolidColorBrush x:Key="MagiOutlineBrush" Color="{StaticResource MagiOutlineColor}" />
    <SolidColorBrush x:Key="MagiOnPrimaryContainerBrush" Color="{StaticResource MagiOnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="MagiOnSecondaryContainerBrush" Color="{StaticResource MagiOnSecondaryContainerColor}" />
    <SolidColorBrush x:Key="MagiOnTertiaryContainerBrush" Color="{StaticResource MagiOnTertiaryContainerColor}" />
    <SolidColorBrush x:Key="MagiOnErrorContainerBrush" Color="{StaticResource MagiOnErrorContainerColor}" />
    <SolidColorBrush x:Key="MagiWarnContainerBrush" Color="{StaticResource MagiWarnContainerColor}" />
    <SolidColorBrush x:Key="MagiOnWarnContainerBrush" Color="{StaticResource MagiOnWarnContainerColor}" />

    <!-- ===== WinUI3 既定スタイルへの適用（クラスコメント「Light1-3/Dark1-3」参照） ===== -->
    <Color x:Key="SystemAccentColor">#FF00504A</Color>
    <Color x:Key="SystemAccentColorLight1">#FF266A65</Color>
    <Color x:Key="SystemAccentColorLight2">#FF4D8580</Color>
    <Color x:Key="SystemAccentColorLight3">#FF739F9B</Color>
    <Color x:Key="SystemAccentColorDark1">#FF00443F</Color>
    <Color x:Key="SystemAccentColorDark2">#FF003834</Color>
    <Color x:Key="SystemAccentColorDark3">#FF002C29</Color>

    <!-- ===== 余白段階（Kotlin原本 MagiTokens.kt の MagiSpacing を1:1移植） ===== -->
    <x:Double x:Key="MagiSpacingXS">4</x:Double>
    <x:Double x:Key="MagiSpacingSM">8</x:Double>
    <x:Double x:Key="MagiSpacingMD">12</x:Double>
    <x:Double x:Key="MagiSpacingLG">16</x:Double>
    <x:Double x:Key="MagiSpacingXL">20</x:Double>
    <x:Double x:Key="MagiSpacingSection">20</x:Double>
    <x:Double x:Key="MagiSpacingScreenH">16</x:Double>

    <!-- ===== 角丸段階（Kotlin原本 MainActivity.kt の MagiTheme 内 Shapes() を移植。
         extraSmall=チップ/入力欄・small=カード・medium=タイル/シート・large=大サーフェス） ===== -->
    <CornerRadius x:Key="MagiCornerXS">10</CornerRadius>
    <CornerRadius x:Key="MagiCornerSM">14</CornerRadius>
    <CornerRadius x:Key="MagiCornerMD">18</CornerRadius>
    <CornerRadius x:Key="MagiCornerLG">24</CornerRadius>

    <!-- ===== タイポグラフィスケール（Kotlin原本 MainActivity.kt の Typography(t) を移植。
         sp→pt を同値のまま使用。LineHeight は各サイズの Kotlin lineHeight 値） ===== -->
    <Style x:Key="MagiDisplaySmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style x:Key="MagiHeadlineSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style x:Key="MagiTitleLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="MagiTitleMediumTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="MagiTitleSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="MagiBodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="MagiBodyMediumTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="MagiBodySmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="MagiLabelLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="MagiLabelMediumTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="MagiLabelSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
</ResourceDictionary>
