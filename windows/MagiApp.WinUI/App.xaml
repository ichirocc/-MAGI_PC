<Application
    x:Class="MagiApp.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                  [デザイントークン] Kotlin原本 MagiTheme（D8決定=UDモードのみ出荷）のブランド色を
                  Styles/MagiTheme.xaml へ移植（詳細・スコープはそのファイルのコメント参照）。
                  MergedDictionaries は同キーなら**後の方が勝つ**ため、既定の XamlControlsResources の
                  後に置く（SystemAccentColor 等を上書きするため）。
                -->
                <ResourceDictionary Source="Styles/MagiTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
