<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinUI 3 / Windows App SDK プロジェクト。この .csproj は Linux サンドボックスでは
      ビルドできない（Windows App SDK の MSBuild ターゲット・.NET for Windows workload・
      WinAppSDK ランタイムが Windows 専用のため）。実機/Windows CI ランナー専用。
      フェーズ0時点では「Hello World」の最小ウィンドウのみ（実起動確認はフェーズ0の
      検証項目として Windows 11 実機で行う）。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MagiApp.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- MagiEngine はプラットフォーム非依存（フェーズ0時点ではまだ空だが将来 v6/model がここに入る） -->
    <ProjectReference Include="..\MagiEngine\MagiEngine.csproj" />
  </ItemGroup>

</Project>
