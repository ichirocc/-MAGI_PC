<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinUI 3 / Windows App SDK プロジェクト。この .csproj は Linux サンドボックスでは
      ビルドできない（Windows App SDK の MSBuild ターゲット・.NET for Windows workload・
      WinAppSDK ランタイムが Windows 専用のため）。実機/Windows CI ランナー専用。
      フェーズ0時点では「Hello World」の最小ウィンドウのみ（実起動確認はフェーズ0の
      検証項目として Windows 11 実機で行う）。

      [フェーズ8, 縦断スライス] MagiApp.ViewModels（フェーズ9で先行実装済みの ViewModel 層）への
      参照と DI コンテナを追加し、「フィクスチャ読込→違反検査→読取専用グリッド表示」の最小経路を通す。
      このプロジェクト自体は引き続き Windows 専用でこのサンドボックスではビルドできないため、
      実際のコンパイル確認は windows-app-build.yml（Windows CI ランナー）が担う。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MagiApp.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- [フェーズ11] インストーラ(installer/MagiApp.iss)が配布する非パッケージ(unpackaged)ビルドの
         exe自体のアイコン。パッケージ版はPackage.appxmanifestのAssets/*.pngが担うため対象外だが、
         非パッケージ版はexeに埋め込まれたWin32アイコンが無いと既定の白紙アイコンになる。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- [フェーズ8] MagiViewModel/EngineOptimizationService の登録に使う最小限のDIコンテナ。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <!-- [CSV取込の文字コード自動判定] .NET は既定でレガシーコードページ（Shift-JIS/CP932=MS932）を
         含まない。Kotlin原本 decodeCsvBytes（MagiApp.kt:140-149、UTF-8厳密デコード失敗時に
         "MS932" へフォールバック）を移植する CsvEncoding.cs（本プロジェクト）が使う。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- MagiEngine はプラットフォーム非依存（v6/model 一式が入っている。WinUI からエンジンの型
         （V6Algorithm 等）を直接参照する場面があるため、MagiApp.ViewModels 経由の間接参照とは
         別に維持する）。 -->
    <ProjectReference Include="..\MagiEngine\MagiEngine.csproj" />
    <!-- [フェーズ8] ViewModel層（フェーズ9で先行実装済み、MagiEngineのみに依存しWinUI非依存）。 -->
    <ProjectReference Include="..\MagiApp.ViewModels\MagiApp.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [フェーズ8] 縦断スライス用の同梱フィクスチャ（MagiEngine.Tests/Fixtures/sample_state_v6.json
         と同一内容。非パッケージ実行(dotnet run)でも動くよう Content としてビルド出力へコピーする）。 -->
    <Content Include="Assets\sample_state_v6.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
