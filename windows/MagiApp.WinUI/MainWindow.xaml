<Window
    x:Class="MagiApp.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      フェーズ0のHello Worldウィンドウ。フェーズ8以降、ここが
      「フィクスチャ読込→初期解生成→検査→読取専用グリッド表示」の縦断スライス、
      最終的にフェーズ9でMagiAppの5タブ本体（ホーム/勤務表/編集/分析/設定）へ置き換わる。
    -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="MAGI ShiftOptimizer" FontSize="28" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Windows 11 ネイティブ版（フェーズ0: 足場）"
                       FontSize="14" Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
