<Window
    x:Class="MagiApp.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] Android版の5タブ（ホーム/勤務表/編集/分析/設定）に対応するナビゲーション殻。
      NavigationView(PaneDisplayMode=Top) の選択に応じて HostContent（ContentControl）の内容を
      差し替える方式（Frame+Page方式ではなく、5タブとも同一の MagiViewModel インスタンスを
      共有するため、コンストラクタ注入で足りる——MainWindow.xaml.cs 参照）。
      各タブの内容は初回選択時に構築してキャッシュする（未選択タブの ObservableObject 購読と
      無駄な再描画を避ける）。
    -->
    <NavigationView x:Name="Nav" PaneDisplayMode="Top"
                     IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                     SelectionChanged="OnNavSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="ホーム" Tag="home" />
            <NavigationViewItem Content="勤務表" Tag="schedule" />
            <NavigationViewItem Content="編集" Tag="edit" />
            <NavigationViewItem Content="分析" Tag="analysis" />
            <NavigationViewItem Content="設定" Tag="settings" />
        </NavigationView.MenuItems>
        <ContentControl x:Name="HostContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
