<Window
    x:Class="MagiApp.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] Android版の5タブ（ホーム/勤務表/編集/分析/設定）に対応するナビゲーション殻。
      NavigationView(PaneDisplayMode=Top) の選択に応じて HostContent（ContentControl）の内容を
      差し替える方式（Frame+Page方式ではなく、5タブとも同一の MagiViewModel インスタンスを
      共有するため、コンストラクタ注入で足りる——MainWindow.xaml.cs 参照）。
      各タブの内容は初回選択時に構築してキャッシュする（未選択タブの ObservableObject 購読と
      無駄な再描画を避ける）。

      [シェル共通の通知バー] Kotlin原本(MagiApp.kt)の Snackbar（自動消滅する一時通知＋
      clearMessage による compare-and-clear）に対応する、タブ非依存の単一 InfoBar。
      Ui.Message/Ui.MessageIsError が変わるたび MainWindow.xaml.cs が開閉させる
      （どのタブを見ていても通知が見える＝Kotlin原本と同じ「シェル全体で1つ」の通知面）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="GlobalMessageBar" Grid.Row="0" Margin="8,8,8,0"
                 IsOpen="False" IsClosable="True" Closed="OnMessageBarClosed" />

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Top"
                         IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                         SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="ホーム" Tag="home" />
                <NavigationViewItem Content="勤務表" Tag="schedule" />
                <NavigationViewItem Content="編集" Tag="edit" />
                <NavigationViewItem Content="分析" Tag="analysis" />
                <NavigationViewItem Content="設定" Tag="settings" />
            </NavigationView.MenuItems>
            <ContentControl x:Name="HostContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
