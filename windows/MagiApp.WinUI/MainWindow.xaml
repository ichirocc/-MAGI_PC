<Window
    x:Class="MagiApp.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] Android版の5タブ（ホーム/勤務表/編集/分析/設定）に対応するナビゲーション殻。
      NavigationView(PaneDisplayMode=Top) の選択に応じて HostContent（ContentControl）の内容を
      差し替える方式（Frame+Page方式ではなく、5タブとも同一の MagiViewModel インスタンスを
      共有するため、コンストラクタ注入で足りる——MainWindow.xaml.cs 参照）。
      各タブの内容は初回選択時に構築してキャッシュする（未選択タブの ObservableObject 購読と
      無駄な再描画を避ける）。

      [シェル共通の通知バー] Kotlin原本(MagiApp.kt)の Snackbar（自動消滅する一時通知＋
      clearMessage による compare-and-clear）に対応する、タブ非依存の単一 InfoBar。
      Ui.Message/Ui.MessageIsError が変わるたび MainWindow.xaml.cs が開閉させる
      （どのタブを見ていても通知が見える＝Kotlin原本と同じ「シェル全体で1つ」の通知面）。
    -->
    <!-- [2026-09-10, ユーザー報告「配色が見にくい」] RequestedTheme を明示しない既定では WinUI3 が
         OS のダーク/ライト設定へ追従する。Android原本は MainActivity.kt:43 で MagiTheme(3)＝UD高
         コントラスト配色を常に固定で呼び出し、システム設定を一切見ない（D8「外観はUD固定」）。
         WinUI 側に同じ強制が無かったため、OS がダークモードのとき既定スタイルの未上書き部分（既定の
         ボタン/スクロールバー等の chrome）だけダーク化し、MagiTheme.xaml のブランド色（白背景・
         黒文字の高コントラスト固定）と混ざって一貫性のない見た目になっていたと考えられる。
         ルートへ RequestedTheme="Light" を明示し、Android と同じ「システム設定に関わらず常に同じ配色」
         を強制する。 -->
    <Grid RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [phase9 #23] トップバー（Kotlin原本 MagiTopBar）: MAGI チップ＋節名＋状態バッジ（実行中/配布可/必須違反N/未計算）。 -->
        <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="10" Background="{StaticResource MagiSurfaceVariantBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource MagiPrimaryBrush}" CornerRadius="{StaticResource MagiCornerXS}" Padding="12,4">
                <TextBlock Text="MAGI" FontWeight="Bold" Foreground="{StaticResource MagiOnPrimaryBrush}" />
            </Border>
            <TextBlock x:Name="SectionTitleText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- [3.670.0] 札の前に自動作成の状態（「未計算」では、警告が今の勤務表の評価か分からなかった）。 -->
                <!-- [3.701.0] 自動保存に失敗しているときだけ error 色の語（押すと保存の失敗のダイアログ）。 -->
                <HyperlinkButton x:Name="SaveWordButton" MinHeight="48" Padding="6,0" Visibility="Collapsed" Click="OnSaveWordClick">
                    <TextBlock x:Name="SaveWordText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MagiErrorBrush}" TextWrapping="Wrap" MaxLines="2" />
                </HyperlinkButton>
                <TextBlock x:Name="StatusPrefixText" FontSize="12" Opacity="0.8" MaxWidth="120" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                <!-- 必須違反が残る＝巡回の入口、必須 0＝配布前の確認（Kotlin MagiTopBar の押せる札）。押せない状態は当たり判定を切る。
                     札の色は中の Border が持つ＝ボタンの背景は重ねた時・押した時も透明（状態の色を既定の灰色で上書きしない）。 -->
                <Button x:Name="StatusBadgeButton" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="48"
                        Visibility="Collapsed" Click="OnStatusBadgeClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </Button.Resources>
                    <Border x:Name="StatusBadge" CornerRadius="{StaticResource MagiCornerXS}" Padding="12,4">
                        <TextBlock x:Name="StatusBadgeText" FontWeight="SemiBold" />
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="GlobalMessageBar" Grid.Row="1" Margin="8,8,8,0" AutomationProperties.LiveSetting="Polite"
                 IsOpen="False" IsClosable="True" Closed="OnMessageBarClosed" />

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Top"
                         IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                         SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="ホーム" Tag="home" />
                <NavigationViewItem Content="勤務表" Tag="schedule" />
                <NavigationViewItem Content="編集" Tag="edit" />
                <NavigationViewItem Content="分析" Tag="analysis" />
                <NavigationViewItem Content="設定" Tag="settings" />
            </NavigationView.MenuItems>
            <ContentControl x:Name="HostContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!-- [phase9 #23] 下部コマンドバー（Kotlin原本 BottomCommandBar）: 元に戻す／やり直し（できるときだけ）＋主ボタン（やめる／勤務表をつくる／再作成する）。 -->
        <Grid x:Name="BottomBar" Grid.Row="3" Padding="16,10" ColumnSpacing="10" Background="{StaticResource MagiSurfaceVariantBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UndoButton" Grid.Column="0" Content="元に戻す" MinHeight="48" Visibility="Collapsed" Click="OnUndoClick" />
            <Button x:Name="RedoButton" Grid.Column="1" Content="やり直し" MinHeight="48" Visibility="Collapsed" Click="OnRedoClick" />
            <Button x:Name="MainActionButton" Grid.Column="2" MinHeight="48" HorizontalAlignment="Stretch" FontSize="16" FontWeight="SemiBold" Click="OnMainActionClick" />
        </Grid>
    </Grid>
</Window>
