<UserControl
    x:Class="MagiApp.WinUI.Views.EditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] 「編集」タブの最初の実装。Kotlin原本（MagiApp.kt の editScope＝入口3分割）と同じく、
      入力場所を「いつ触るか」で分ける——月次条件(毎月)／職員管理(随時)／年間マスター(制度変更時のみ)。
      4か所目の勤務表グリッドは「勤務表」タブが担当する。

      この第1段は Kotlin原本のカード群（WishCard/NeedCalendarCard/Ws1Card/ConstraintsCard 等）の
      本格移植ではなく、各ドアの骨格＋既存の公開 ViewModel メソッドへ確実に配線できる操作のみ:
        月次条件   … 対象期間の表示・「来月にする」(SetNextMonth)・希望/日別必要人数の一覧・追加/削除
                     (WishOverrides/SetWish/RemoveWish・NeedDayOverrides/SetNeedDay/RemoveNeedDay)
        職員管理   … 職員一覧の表示と 追加/改名・所属変更/削除 (Ws1AddStaff/Ws1EditStaff/Ws1RemoveStaff)＋
                     個人別の回数=下限/上限の設定/削除(SetStaffRange/RemoveStaffRange、2026-09-02追加。
                     一覧はStaffCountRules=個人別レンジと適切回数(apt)の実効目標を統合したビュー)
        年間マスター … シフトの追加/改名/削除(Ws1AddShift/Ws1EditShift/Ws1RemoveShift)＋
                     グループの追加/改名/削除(Ws1AddGroup/Ws1EditGroup/Ws1RemoveGroup)＋
                     スキル区分の追加/改名/削除(AddSkillGroup/EditSkillGroup/RemoveSkillGroup、
                     cons41s/cons42sの対象自体を作る手段。職員管理のスキル割当と対)＋
                     群×シフトの担当可否・適切回数マトリクス(Ws1SetGroupShift/Ws1SetGroupApt/
                     Ws1ResetGroupApt、EditView.xaml.cs の BuildGroupShiftMatrix 参照)＋
                     上限人数(2パターン目)の使用可否(Ws1SetUse2)＋
                     グループ単位の回数の一括設定/解除(SetGroupRange/ClearGroupRange、2026-09-02追加。
                     GroupRangeSummaryから一覧表示)＋見直し候補メモ(AddReviewMemo/RemoveReviewMemo、
                     2026-09-02追加。追加口はここの手動欄と勤務表タブのセル編集フライアウトの2つ)＋
                     制約(ルール)10族の追加/変更/削除(AddCons*/UpdateConstraint/RemoveConstraint、
                     フィールド構成は EditView.xaml.cs の ConstraintFamilyMetas 参照)
      [2026-09-02, 配線] 上記のうちスキル区分CRUD・群×シフトマトリクス・Use2トグルは、対応する
      ViewModel API がフェーズ9で移植済みだったにも関わらずこの画面に一度も呼び出し口が無かった
      「配線されていない箱」——特に群×シフトのcanDo設定は新規データで誰も担当できるシフトを設定できない
      という実運用上のギャップだった。職員管理のスキル区分選択(StaffSkillCombo)も同じタイミングで追加
      （SetStaffSkillは追加/改名アクションと独立APIのため、追加・改名の直後に続けて呼ぶ）。
      削除系（職員/グループ/スキル区分）は EditView.xaml.cs の ConfirmAsync（ContentDialog）で確認を挟む
      （シフト削除は該当マスがKotlin原本と同じく「休」/先頭シフトへ吸収されるだけで大量破壊的では
      ないため、職員/グループ/スキル区分と同じ確認ダイアログは課さず参照件数(Ws1ShiftRefCount)を
      ヒント文で示す）。
      ドアの切替は ComboBox（SettingsView.xaml の計算方式セレクタと同じ書き方）で行い、各ドアの
      StackPanel の Visibility をコードビハインドで切り替える。

      レンダリングは全てコードビハインド（ScheduleView と同じ方針・x:Bind/{Binding} は使わない）。
      Render() でコントロールの値をプログラム的に設定するため、SettingsView と同じ _syncingFromModel
      フラグでイベントの逆流を止める。
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="編集" FontSize="20" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock Text="どこを直しますか" />
                <ComboBox x:Name="DoorCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnDoorChanged">
                    <ComboBoxItem Content="月次条件（毎月）" />
                    <ComboBoxItem Content="職員管理（随時）" />
                    <ComboBoxItem Content="年間マスター（制度変更時のみ）" />
                </ComboBox>
                <TextBlock x:Name="DoorHintText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===== 月次条件（毎月） ===== -->
            <StackPanel x:Name="MonthlyPanel" Spacing="8">
                <TextBlock Text="月次条件" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="PeriodText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrevMonthButton" Content="前の月" Click="OnPrevMonthClick" />
                    <Button x:Name="NextStepMonthButton" Content="次の月" Click="OnNextStepMonthClick" />
                    <Button x:Name="NextMonthButton" Content="来月にする" Click="OnNextMonthClick" />
                </StackPanel>
                <TextBlock x:Name="MonthlyCountsText" TextWrapping="Wrap" FontSize="13" Opacity="0.8" />
                <Border x:Name="NextStepPanel" Background="{StaticResource MagiSecondaryContainerBrush}"
                        CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                    <TextBlock x:Name="NextStepText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}"
                               Foreground="{StaticResource MagiOnSecondaryContainerBrush}" />
                </Border>

                <TextBlock Text="希望シフト" FontWeight="SemiBold" Margin="0,8,0,0" />

                <TextBlock Text="職員を選んでカレンダーから複数日をまとめて選択できます" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                <ComboBox x:Name="WishStaffCombo" HorizontalAlignment="Stretch" PlaceholderText="職員"
                          SelectionChanged="OnWishStaffSelectionChanged" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="WishCalendarHost" />
                </ScrollViewer>
                <StackPanel x:Name="WishApplyPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="WishApplySummaryText" FontSize="12" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="WishApplyShiftCombo" Width="100" PlaceholderText="シフト"
                                  SelectionChanged="OnWishApplyShiftSelectionChanged" />
                        <Button x:Name="ApplyWishesForDaysButton" Content="適用" Click="OnApplyWishesForDaysClick" />
                        <Button x:Name="ClearWishesForDaysButton" Content="選択した日を未設定に戻す" Click="OnClearWishesForDaysClick" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="登録済みの希望（1件ずつ確認・削除）" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
                <StackPanel x:Name="WishListHost" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="WishDayBox" Width="56" PlaceholderText="日" />
                    <ComboBox x:Name="WishShiftCombo" Width="100" PlaceholderText="シフト" />
                    <Button x:Name="SetWishButton" Content="設定" Click="OnSetWishClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="ApplyWishesButton" Content="希望をすべて勤務表へ反映" Click="OnApplyWishesClick" />
                    <Button x:Name="ClearAllWishesButton" Content="希望をすべて削除" Click="OnClearAllWishesClick" />
                </StackPanel>
                <TextBlock x:Name="WishHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="日別の必要人数（例外）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <!-- [phase9 #13] 必要人数カレンダー（Kotlin原本 NeedDayEditor.kt NeedMonthGrid/NeedApplyPanel）: シフトを選び複数日をまとめて設定。 -->
                <TextBlock Text="シフトを選んでカレンダーから複数日をまとめて選択できます（各日の表示＝その日の必要人数、太字＝個別設定）" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                <ComboBox x:Name="NeedCalShiftCombo" HorizontalAlignment="Stretch" PlaceholderText="シフト"
                          SelectionChanged="OnNeedCalShiftSelectionChanged" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="NeedCalendarHost" />
                </ScrollViewer>
                <StackPanel x:Name="NeedApplyPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="NeedApplySummaryText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NeedApplyP1Box" Width="80" Header="最低人数" PlaceholderText="既定" TextChanged="OnNeedApplyTextChanged" />
                        <TextBox x:Name="NeedApplyP2Box" Width="80" Header="上限人数" PlaceholderText="既定" TextChanged="OnNeedApplyTextChanged" />
                    </StackPanel>
                    <TextBlock x:Name="NeedApplyHintText" FontSize="12" Foreground="{StaticResource MagiErrorBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyNeedForDaysButton" Content="適用" Click="OnApplyNeedForDaysClick" />
                        <Button x:Name="ClearNeedForDaysButton" Content="選択した日を未設定に戻す" Click="OnClearNeedForDaysClick" />
                        <Button x:Name="CancelNeedSelectionButton" Content="キャンセル" Click="OnCancelNeedSelectionClick" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="登録済みの例外（1件ずつ確認・削除）" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
                <StackPanel x:Name="NeedDayListHost" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="NeedDayShiftCombo" Width="100" PlaceholderText="シフト" />
                    <TextBox x:Name="NeedDayDayBox" Width="56" PlaceholderText="日" />
                    <TextBox x:Name="NeedDayP1Box" Width="56" PlaceholderText="最低" />
                    <TextBox x:Name="NeedDayP2Box" Width="56" PlaceholderText="上限" />
                    <Button x:Name="SetNeedDayButton" Content="設定" Click="OnSetNeedDayClick" />
                </StackPanel>
                <TextBlock x:Name="NeedDayHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            </StackPanel>

            <!-- ===== 職員管理（随時） ===== -->
            <StackPanel x:Name="StaffPanel" Spacing="8">
                <TextBlock Text="職員管理" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="StaffSummaryText" TextWrapping="Wrap" FontSize="13" Opacity="0.8" />
                <StackPanel x:Name="StaffListHost" Spacing="2" />

                <TextBlock Text="対象の職員（改名・所属変更・削除）" />
                <ComboBox x:Name="StaffCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnStaffSelectionChanged" />

                <TextBlock Text="名前" />
                <TextBox x:Name="StaffNameBox" HorizontalAlignment="Stretch" />

                <TextBlock Text="所属グループ" />
                <ComboBox x:Name="GroupCombo" HorizontalAlignment="Stretch" />

                <TextBlock Text="スキル区分（cons41s/cons42sの対象。追加・改名・変更は「年間マスター」）" />
                <ComboBox x:Name="StaffSkillCombo" HorizontalAlignment="Stretch" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddStaffButton" Content="追加" Click="OnAddStaffClick" />
                    <Button x:Name="EditStaffButton" Content="改名・所属変更" Click="OnEditStaffClick" />
                    <Button x:Name="RemoveStaffButton" Content="削除" Click="OnRemoveStaffClick" />
                </StackPanel>

                <TextBlock x:Name="StaffHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="個人別の回数（下限・上限。対象は上の「対象の職員」）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel x:Name="StaffRangeListHost" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="StaffRangeShiftCombo" Width="100" PlaceholderText="シフト" />
                    <TextBox x:Name="StaffRangeLoBox" Width="56" PlaceholderText="下限" />
                    <TextBox x:Name="StaffRangeHiBox" Width="56" PlaceholderText="上限" />
                    <Button x:Name="SetStaffRangeButton" Content="設定" Click="OnSetStaffRangeClick" />
                </StackPanel>
                <TextBlock x:Name="StaffRangeHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <!-- [phase9 #12] 回数マトリクス（Kotlin原本 StaffShiftMatrixCard, 3.477.0）: 行=職員・列=シフトに担当可否・目標・上下限・実績を統合。 -->
                <TextBlock Text="回数マトリクス（職員 × シフト：月に何回か）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="セルをタップで目標・上下限を編集。「—」＝担当不可（担当可否は年間マスターで変更）。薄色＝目標(やわらかい)のズレ、濃色＝個人の上下限(かたい)の逸脱。" />
                <Border x:Name="AptOverloadBanner" Background="{StaticResource MagiErrorContainerBrush}"
                        CornerRadius="{StaticResource MagiCornerXS}" Padding="10,6">
                    <TextBlock x:Name="AptOverloadText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MagiOnErrorContainerBrush}" />
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="StaffShiftMatrixHost" />
                </ScrollViewer>
            </StackPanel>

            <!-- ===== 年間マスター（制度変更時のみ） ===== -->
            <StackPanel x:Name="MasterPanel" Spacing="8">
                <TextBlock Text="年間マスター" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="土台の設定（制度変更時のみ）。毎月の調整は「月次条件」、人の入替は「職員管理」へ。"
                           TextWrapping="Wrap" FontSize="13" Opacity="0.8" />

                <TextBlock Text="見直し候補メモ" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="勤務表タブでセルの違反枠をタップ→「見直し候補にする」で積めます（このセッション内のみ・保存されません）。" />
                <StackPanel x:Name="ReviewMemoListHost" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ReviewMemoBox" Width="240" PlaceholderText="メモを直接追加" />
                    <Button x:Name="AddReviewMemoButton" Content="追加" Click="OnAddReviewMemoClick" />
                </StackPanel>

                <TextBlock Text="期間（日数）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="暦通りの月以外（例：15日間の一部期間）を使うときはここで直接変えます。通常は「月次条件」の月移動で足ります。"
                           TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="MasterDaysBox" Width="80" PlaceholderText="日数(1-31)" />
                    <Button x:Name="EditMasterDaysButton" Content="変更" Click="OnEditMasterDaysClick" />
                </StackPanel>
                <TextBlock x:Name="MasterDaysHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="シフト" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="ShiftListText" TextWrapping="Wrap" FontSize="13" />

                <TextBlock Text="シフトの追加・改名・削除" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="MasterShiftCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnMasterShiftSelectionChanged" />
                <TextBlock Text="名前" />
                <TextBox x:Name="MasterShiftNameBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="記号" />
                <TextBox x:Name="MasterShiftKigouBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="最低人数 / 上限人数（1日あたり・空欄可）" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="MasterShiftNeed1Box" Width="80" PlaceholderText="最低" />
                    <TextBox x:Name="MasterShiftNeed2Box" Width="80" PlaceholderText="上限" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddMasterShiftButton" Content="追加" Click="OnAddMasterShiftClick" />
                    <Button x:Name="EditMasterShiftButton" Content="改名・変更" Click="OnEditMasterShiftClick" />
                    <Button x:Name="RemoveMasterShiftButton" Content="削除" Click="OnRemoveMasterShiftClick" />
                </StackPanel>
                <TextBlock x:Name="MasterShiftHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="グループ" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="GroupListText" TextWrapping="Wrap" FontSize="13" />

                <TextBlock Text="グループの追加・改名・削除" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="MasterGroupCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnMasterGroupSelectionChanged" />
                <TextBlock Text="名前" />
                <TextBox x:Name="MasterGroupNameBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="記号" />
                <TextBox x:Name="MasterGroupKigouBox" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddMasterGroupButton" Content="追加" Click="OnAddMasterGroupClick" />
                    <Button x:Name="EditMasterGroupButton" Content="改名" Click="OnEditMasterGroupClick" />
                    <Button x:Name="RemoveMasterGroupButton" Content="削除" Click="OnRemoveMasterGroupClick" />
                </StackPanel>
                <TextBlock x:Name="MasterGroupHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="グループ単位の回数（一括設定）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="グループ全員に同じ下限/上限をまとめて設定します（既に個人別で設定済みの職員はスキップ・保持されます）。下限=上限ならそのシフトの適切回数(apt)も同時に設定されます。" />
                <StackPanel x:Name="GroupRangeListHost" Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="GroupRangeGroupCombo" Width="120" PlaceholderText="グループ" />
                    <ComboBox x:Name="GroupRangeShiftCombo" Width="100" PlaceholderText="シフト" />
                    <TextBox x:Name="GroupRangeLoBox" Width="56" PlaceholderText="下限" />
                    <TextBox x:Name="GroupRangeHiBox" Width="56" PlaceholderText="上限" />
                    <Button x:Name="SetGroupRangeButton" Content="一括設定" Click="OnSetGroupRangeClick" />
                </StackPanel>
                <TextBlock x:Name="GroupRangeHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="スキル区分" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="SkillGroupListText" TextWrapping="Wrap" FontSize="13" />

                <TextBlock Text="スキル区分の追加・改名・削除" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="MasterSkillGroupCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnMasterSkillGroupSelectionChanged" />
                <TextBlock Text="名前" />
                <TextBox x:Name="MasterSkillGroupNameBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="記号" />
                <TextBox x:Name="MasterSkillGroupKigouBox" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddMasterSkillGroupButton" Content="追加" Click="OnAddMasterSkillGroupClick" />
                    <Button x:Name="EditMasterSkillGroupButton" Content="改名" Click="OnEditMasterSkillGroupClick" />
                    <Button x:Name="RemoveMasterSkillGroupButton" Content="削除" Click="OnRemoveMasterSkillGroupClick" />
                </StackPanel>
                <TextBlock x:Name="MasterSkillGroupHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

                <TextBlock Text="担当できるシフト（群×シフト）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="セルをタップで担当ON/OFF（✓=担当できる）。群名をタップでその群を一括、シフト名をタップで全グループへ一括。「休」は外せません。" />
                <ToggleSwitch x:Name="Use2Toggle" Header="上限人数（2パターン目）を使う" OnContent="ON" OffContent="OFF"
                              Toggled="OnUse2Toggled" />
                <!-- [マトリックス] 左列（群名）は固定、右側（シフト名ヘッダ＋セル）だけ横スクロール。
                     行の高さを両側で揃えて（44）ヘッダ/セルが横にずれないようにする。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="GroupShiftNameColumn" Grid.Column="0" />
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="GroupShiftMatrixHost" />
                    </ScrollViewer>
                </Grid>

                <TextBlock Text="適切回数（1人あたり・群×シフト）" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="1人あたりの期間内目標（空欄=目標なし。欄を離れると反映）。担当できないシフトの欄は入力できません。" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="GroupAptMatrixHost" />
                </ScrollViewer>
                <Border x:Name="AptOverloadPanel" Visibility="Collapsed" Background="#FFFDEDED"
                        BorderBrush="#FFB00020" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="この目標は達成できません" FontWeight="SemiBold" FontSize="13" Foreground="#FFB00020" />
                        <StackPanel x:Name="AptOverloadList" Spacing="2" />
                    </StackPanel>
                </Border>
                <Button x:Name="ResetAptButton" Content="適切回数を全リセット" Click="OnResetAptClick"
                        HorizontalAlignment="Left" Margin="0,4,0,0" />

                <TextBlock Text="登録済みのルール" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel x:Name="ConstraintListHost" Spacing="2" />

                <TextBlock Text="ルールの追加・変更・削除" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="種類" />
                <ComboBox x:Name="ConstraintFamilyCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnConstraintFamilyChanged">
                    <ComboBoxItem Content="窓の要件（cons1）" Tag="cons1" />
                    <ComboBoxItem Content="個人の合計（cons2）" Tag="cons2" />
                    <ComboBoxItem Content="必須の並び（cons3）" Tag="cons3" />
                    <ComboBoxItem Content="禁止の並び（cons3n）" Tag="cons3n" />
                    <ComboBoxItem Content="推奨の並び（cons3m）" Tag="cons3m" />
                    <ComboBoxItem Content="回避の並び（cons3mn）" Tag="cons3mn" />
                    <ComboBoxItem Content="群のレンジ（cons41）" Tag="cons41" />
                    <ComboBoxItem Content="群ペア禁止（cons42）" Tag="cons42" />
                    <ComboBoxItem Content="スキル群のレンジ（cons41s）" Tag="cons41s" />
                    <ComboBoxItem Content="スキル群ペア禁止（cons42s）" Tag="cons42s" />
                </ComboBox>
                <TextBlock Text="変更・削除する行（新規追加なら未選択のまま）" />
                <ComboBox x:Name="ConstraintRowCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnConstraintRowSelectionChanged" />

                <!-- [シフト記号欄=ComboBox] cons1/cons2/cons41(s)/cons42(s) のシフト記号欄は、既存シフトから
                     選べる編集可能ComboBox（IsEditable=既存データ整合用の自由入力も残す）。それ以外の欄
                     （群記号・回数・cons3系の並び等）は従来どおりTextBox。同じ枠位置に両方を重ねて置き、
                     選んだ制約の種類に応じてどちらかだけを表示する（EditView.xaml.cs SyncConstraintFields参照）。 -->
                <TextBlock x:Name="ConstraintField1Label" Text="項目1" />
                <TextBox x:Name="ConstraintField1Box" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ConstraintField1ShiftCombo" HorizontalAlignment="Stretch" IsEditable="True"
                          PlaceholderText="シフト" Visibility="Collapsed" />
                <TextBlock x:Name="ConstraintField2Label" Text="項目2" />
                <TextBox x:Name="ConstraintField2Box" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ConstraintField2ShiftCombo" HorizontalAlignment="Stretch" IsEditable="True"
                          PlaceholderText="シフト" Visibility="Collapsed" />
                <TextBlock x:Name="ConstraintField3Label" Text="項目3" />
                <TextBox x:Name="ConstraintField3Box" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ConstraintField3ShiftCombo" HorizontalAlignment="Stretch" IsEditable="True"
                          PlaceholderText="シフト" Visibility="Collapsed" />
                <TextBlock x:Name="ConstraintField4Label" Text="項目4" />
                <TextBox x:Name="ConstraintField4Box" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ConstraintField4ShiftCombo" HorizontalAlignment="Stretch" IsEditable="True"
                          PlaceholderText="シフト" Visibility="Collapsed" />
                <TextBlock x:Name="ConstraintField5Label" Text="項目5" />
                <TextBox x:Name="ConstraintField5Box" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="ConstraintField5ShiftCombo" HorizontalAlignment="Stretch" IsEditable="True"
                          PlaceholderText="シフト" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddConstraintButton" Content="追加" Click="OnAddConstraintClick" />
                    <Button x:Name="UpdateConstraintButton" Content="変更" Click="OnUpdateConstraintClick" />
                    <Button x:Name="RemoveConstraintButton" Content="削除" Click="OnRemoveConstraintClick" />
                </StackPanel>
                <TextBlock x:Name="ConstraintHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
