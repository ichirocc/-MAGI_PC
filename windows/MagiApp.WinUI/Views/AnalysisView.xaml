<UserControl
    x:Class="MagiApp.WinUI.Views.AnalysisView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] 「分析」タブの最初の実装。読取専用の診断ビューで、UiState に既にある値
      （サマリー・違反の内訳・設定の見直し候補・回数の固定で止まった手・診断ログ）だけを並べる。
      修復導線のうち改善提案の適用・設定ミスのワンタップ修正・場所（該当セル）へのジャンプ
      （勤務表タブへ切替＋スクロール＋一時ハイライト）は追加済み（下記・AnalysisView.xaml.cs参照）。
      ジャンプ対象はセル単位の違反（UiState.ViolationCells に載る族=groupViol/pref/c3n/c1/c3/c3m/c3mn）
      のみ——covU/covO/c41系（日単位）やlow/high/apt/c2（職員単位）は特定の1セルを指さないため対象外。

      Kotlin原本の分析タブ（AnalysisTriage.kt / MagiDashboardCards.kt の診断カード群）の本格移植では
      なく、その中で「読むだけで価値があり、かつ UiState だけで描ける」部分の最小版。

      節ごと（サマリー/内訳/…）に x:Name 付きの StackPanel を置き、コードビハインドの Render() が
      中身を作り直して Visibility を切り替える（データが無い節は箱ごと隠す＝空の箱を見せない）。
      ScheduleView と同じくコードビハインド駆動——内訳の行数も設定ミスの件数も可変で、XAML の
      静的テンプレートでは表現しづらいため。

      [直し方を探す] MagiViewModel.FindFixSuggestions/ApplyFixSuggestion（フェーズ9で移植・テスト済み）
      への導線を追加（Kotlin原本 FixSuggestionCard 相当・AnalysisView.xaml.cs 参照）。
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="分析" FontSize="20" FontWeight="SemiBold" />

            <!-- 未読込のときだけ出す案内（下の各節はすべて非表示になる）。 -->
            <TextBlock x:Name="EmptyText" FontSize="13" TextWrapping="Wrap" Opacity="0.7"
                       Text="データを読み込むと、ここに診断が出ます。" />

            <!-- ① サマリー -->
            <StackPanel x:Name="SummarySection" Spacing="6">
                <TextBlock Text="サマリー" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="HintText" FontSize="13" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <!-- [phase9 #18] 要確認（Kotlin原本 AnalysisTriageCard, 3.471.0）: 分類の軸は「族」でなく「診断」。 -->
            <StackPanel x:Name="TriageSection" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="要確認" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="TriageBadge" CornerRadius="{StaticResource MagiCornerXS}" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TriageBadgeText" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TriageAllClearText" FontSize="13" Foreground="{StaticResource MagiTertiaryBrush}"
                           Text="確認事項はありません（すべての条件を満たしています）。" />
                <TextBlock x:Name="TriageBlockersTitle" Text="直さないと消えない項目" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource MagiErrorBrush}" />
                <StackPanel x:Name="TriageBlockersList" Spacing="6" />
                <TextBlock x:Name="TriageSearchTitle" FontSize="14" FontWeight="SemiBold" />
                <Border x:Name="TriageSearchPanel" Background="{StaticResource MagiSurfaceVariantBrush}"
                        CornerRadius="{StaticResource MagiCornerSM}" Padding="10">
                    <StackPanel x:Name="TriageSearchList" Spacing="2" />
                </Border>
                <HyperlinkButton x:Name="TriageSummaryToggle" Padding="0" Click="OnTriageSummaryToggleClick" />
                <StackPanel x:Name="TriageSummaryList" Spacing="2" Visibility="Collapsed" />
                <TextBlock x:Name="TriageRunningNote" FontSize="12" Opacity="0.8" Text="※実行中のため確定前の値です（確定後に最新化）" />
            </StackPanel>

            <!-- ② 違反の内訳 -->
            <StackPanel x:Name="BreakdownSection" Spacing="6">
                <TextBlock Text="違反の内訳" FontSize="16" FontWeight="SemiBold" />
                <StackPanel x:Name="BreakdownList" Spacing="2" />
            </StackPanel>

            <!-- 違反の場所（タップで勤務表タブへジャンプ） -->
            <StackPanel x:Name="LocationsSection" Spacing="6">
                <TextBlock Text="違反の場所" FontSize="16" FontWeight="SemiBold" />
                <StackPanel x:Name="LocationsList" Spacing="4" />
            </StackPanel>

            <!-- 直し方を探す -->
            <StackPanel x:Name="FixSection" Spacing="6">
                <TextBlock Text="直し方を探す" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="FixSearchButton" Content="直し方を探す" Click="OnFixSearchClick" HorizontalAlignment="Left" />
                <TextBlock x:Name="FixSearchingText" FontSize="13" Opacity="0.8" Text="探索中…" />
                <StackPanel x:Name="FixList" Spacing="10" />
            </StackPanel>

            <!-- ③ 設定の見直し候補 -->
            <!-- [phase9 #19] Kotlin原本 SettingIssuesCard（3.480.0）: 一括クリア→既定で畳んだ一覧（上位6件）→編集導線。 -->
            <StackPanel x:Name="IssuesSection" Spacing="8">
                <TextBlock x:Name="IssuesTitle" Text="設定の見直し" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="ClearOutOfScopeWishesButton" HorizontalAlignment="Stretch" Click="OnClearOutOfScopeWishesClick" />
                <HyperlinkButton x:Name="IssuesToggle" Padding="0" Click="OnIssuesToggleClick" />
                <StackPanel x:Name="IssuesList" Spacing="8" Visibility="Collapsed" />
                <Button x:Name="IssuesGoEditButton" Content="設定・希望を編集する" HorizontalAlignment="Left" Click="OnIssuesGoEditClick" />
            </StackPanel>

            <!-- ④ 回数の固定で止まった手 -->
            <StackPanel x:Name="PinSection" Spacing="6">
                <TextBlock Text="回数の固定で止まった手" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="PinSummaryText" FontSize="13" TextWrapping="Wrap" />
                <StackPanel x:Name="PinList" Spacing="4" />
            </StackPanel>

            <!-- ④' 禁止の並び診断（なぜ崩せないか） -->
            <StackPanel x:Name="ForbiddenSection" Spacing="6">
                <TextBlock Text="禁止の並びで止まっている箇所" FontSize="16" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8"
                           Text="このデータ・希望のままでは崩せないと判定された禁止の並び(c3n)です。緩める＝その制約行を削除します（元に戻す可）。" />
                <StackPanel x:Name="ForbiddenList" Spacing="4" />
            </StackPanel>

            <!-- ⑤ 診断ログ -->
            <StackPanel x:Name="LogSection" Spacing="6">
                <TextBlock Text="診断ログ" FontSize="16" FontWeight="SemiBold" />
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="8">
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontSize="12" FontFamily="Consolas"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
