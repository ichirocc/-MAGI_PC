<UserControl
    x:Class="MagiApp.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] 「設定」タブ。Kotlin原本 SettingsCard（最適化設定）に相当する部分——
      並列数・最適化時間・最適化方式・仕上げ最適化・ネイティブ加速表示・パリティ照合表示・禁止連続の
      事前フィルタ/崩し範囲。いずれも既存の MagiViewModel セッター（SetWorkers 等、フェーズ9ピース5で
      移植済み・テスト済み）へ直接委譲するだけの薄い配線。
      表示色（シフトの記号色・違反枠の基準色/族別色、Kotlin原本 ColorSettingsView 相当）は
      SettingsView.xaml.cs の RenderShiftColors/RenderViolationColors がコードビハインドで動的に
      組み立てる（シフト数・族数が可変のため静的XAMLでは表現しづらい）。設定した色は
      ScheduleView.xaml.cs の ResolveVioBrush/AddDataCell が共有元の ColorHex 経由で実際の
      勤務表グリッド表示へ反映する。外観（片手モード等）は対応する MagiViewModel API が無く
      今後の段階のまま。データ入出力（本ファイル下部）は Kotlin原本の
      ファイル選択コード（<c>ui/MagiApp.kt</c>）相当をこの移植では SettingsView.xaml.cs に置く。
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">
            <!-- [Android 3.714.0] 見出し「設定」＋組む時間の 1 行＋主ボタン（仕上げの秒数はツールチップ）。 -->
            <!-- [UI-S7] 区分は 計算・表示（色は畳む）・データ・詳細設定（畳む）。Android 3.727.11。 -->
            <TextBlock Text="計算" FontSize="20" FontWeight="SemiBold" />

            <!-- [Android 3.706.0] 保存に失敗している間だけ、時間のカードの上で直す（データ欄の同じ文は隠す）。 -->
            <StackPanel x:Name="SaveFailedBanner" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="SaveFailedBannerText" TextWrapping="Wrap" FontWeight="Bold" Foreground="{StaticResource MagiErrorBrush}" />
                <Button x:Name="SaveFailedRetryButton" Content="もう一度保存する" Click="OnRetrySaveClick" HorizontalAlignment="Stretch" MinHeight="48"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!-- [Android 3.706.0] 状態の 1 行と「組む時間を変える」（候補はダイアログ。既定 60 秒・範囲 10〜300 秒は不変）。 -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="BudgetLabel" Text="組む時間" TextWrapping="Wrap" />
                <Button x:Name="ChangeBudgetButton" Content="組む時間を変える" Click="OnChangeBudgetClick" HorizontalAlignment="Stretch" MinHeight="48"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!-- [Android 3.698.0 / C# だけ] ホームの 3 ボタン（つくる・バックグラウンド・やめる）は主ボタンと下部バーに重複するので外し、背景実行だけここへ。 -->
            <StackPanel Spacing="4">
                <Button x:Name="BackgroundRunButton" Content="バックグラウンドで勤務表をつくる" Click="OnBackgroundRunClick" HorizontalAlignment="Stretch" MinHeight="48" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                           Text="ほかのタブで編集しながら組めます。結果は今の勤務表より良いときだけ置き換えます。ウィンドウを閉じると止まります。" />
            </StackPanel>

            <!-- [Android 3.615.0同期] 探索スイッチ群を 2 択 1 つに統合（ユーザー決定）。 -->
            <ComboBox x:Name="SearchStrengthCombo" Header="探す強さ" SelectionChanged="OnSearchStrengthChanged">
                <ComboBoxItem Content="ふつう" Tag="Normal" />
                <ComboBoxItem Content="じっくり" Tag="Thorough" />
            </ComboBox>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                       Text="じっくり: 時間いっぱい粘り、細かい違反をもう一歩減らします。結果が良くなるとは限りません。" />
            <ToggleSwitch x:Name="AptFairUnguardedToggle" Header="容認 6% で重い違反の増加も許す"
                          OnContent="ON" OffContent="OFF" Toggled="OnAptFairUnguardedToggled" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                       Text="試験中。じっくりのときだけ、期間の制約などが1件増える手も採ります（測定では効果なし・既定OFF）" />

            <!-- [Android 3.683.0] 最適化方式は詳細設定（上級者向け）の中。一般の運用では触らない。 -->
            <Expander Header="詳細設定（上級者向け）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                               Text="計算方式・同時に計算する数・仕上げの調整。一般の運用では触りません。" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="WorkersLabel" Text="同時に計算する数" />
                        <Slider x:Name="WorkersSlider" Minimum="1" Maximum="16" StepFrequency="1"
                                ValueChanged="OnWorkersChanged" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SoftPolishToggle" Header="仕上げ" OnContent="ON" OffContent="OFF"
                                  Toggled="OnSoftPolishToggled" />
                    <StackPanel Spacing="2">
                        <ToggleSwitch x:Name="AgentAutoToggle" OnContent="ON" OffContent="OFF" Toggled="OnAgentAutoToggled" />
                        <TextBlock x:Name="AgentAutoNote" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                    </StackPanel>
                    <!-- ネイティブ加速はこの移植では常に対象外（C++加速層が無い）。設定データの往復互換のため表示専用で保持。 -->
                    <ToggleSwitch x:Name="NativeAccelToggle" Header="ネイティブ加速（このC#移植では常に非該当）"
                                  OnContent="ON" OffContent="OFF" IsEnabled="False" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="最適化方式" />
                        <ComboBox x:Name="AlgorithmCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnAlgorithmChanged">
                            <ComboBoxItem Content="おまかせ（予算から自動選択）" Tag="Auto" />
                            <ComboBoxItem Content="高速（並列SA・短時間向け）" Tag="V5" />
                            <ComboBoxItem Content="ALNS（破壊・修復マルチリスタート）" Tag="Alns" />
                            <ComboBoxItem Content="RSI（最大違反族に集中）" Tag="Rsi" />
                            <ComboBoxItem Content="RSI++（シード→仮説→精製→研磨）" Tag="RsiPlus" />
                            <ComboBoxItem Content="Portfolio（異種適応アンサンブル）" Tag="Portfolio" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- [phase9 #22] 重み表（Kotlin原本 WeightTableCard）。最適化の優先順位の根拠＝実行条件の隣が定位置。値は MirrorKeys.Weights そのもの。 -->
            <TextBlock Text="表示" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ToggleSwitch x:Name="LeftHandToggle" Header="セル編集の利き手" OnContent="左手" OffContent="右手"
                          Toggled="OnLeftHandToggled" />

            <Expander Header="色" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                               Text="シフトの記号色・違反枠の色を変更できます。「既定に戻す」で手動設定を消して既定色へ戻ります。" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="シフトの表示色" Style="{StaticResource MagiTitleSmallTextStyle}" />
                        <StackPanel x:Name="ShiftColorList" Spacing="4" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="違反の基準色" Style="{StaticResource MagiTitleSmallTextStyle}" />
                        <StackPanel x:Name="ViolationBaseColorList" Spacing="4" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="違反種別ごとの色（族別・未設定は基準色を使用）" Style="{StaticResource MagiTitleSmallTextStyle}" />
                        <StackPanel x:Name="ViolationFamilyColorList" Spacing="4" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="直す優先順位" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4">
                    <TextBlock Text="上にあるものから先に直します。" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="WeightTableHost" Spacing="2" MaxWidth="420" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <TextBlock Text="データ" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <!-- 自動保存の状態（Kotlin DataCard、Android 3.529.0）。保存済みのときは出さない。 -->
            <TextBlock x:Name="SaveStateText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Visibility="Collapsed" />
            <Button x:Name="RetrySaveButton" Content="もう一度保存する" Click="OnRetrySaveClick" HorizontalAlignment="Stretch" MinHeight="48" Visibility="Collapsed" />
            <StackPanel Spacing="8">
                <Button x:Name="OpenDataButton" Content="データを開く（JSON）" Click="OnOpenDataClick" HorizontalAlignment="Stretch" />
                <Button x:Name="SaveDataButton" Content="データを保存（JSON）" Click="OnSaveDataClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ImportCsvButton" Content="勤務表CSVを取り込む" Click="OnImportCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ExportCsvButton" Content="勤務表CSVを書き出す" Click="OnExportCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="CheckProblemsButton" Content="問題がないか調べる" Click="OnCheckProblemsClick" HorizontalAlignment="Stretch" />
                <Button x:Name="RestorePreviousDataButton" Content="「データを開く」前の状態に戻す"
                        Click="OnRestorePreviousDataClick" HorizontalAlignment="Stretch" />
                <Button x:Name="NewBlankDataButton" Content="新規作成（空のデータから始める）"
                        Click="OnNewBlankDataClick" HorizontalAlignment="Stretch" />
            </StackPanel>

            <TextBlock Text="データ（種類別のCSV）" Style="{StaticResource MagiTitleSmallTextStyle}" Margin="0,8,0,0" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                       Text="職員一覧・希望シフト・各制約だけを別々に取込/書出できます（取込は今のデータに重ねます。氏名一致で更新）。" />
            <StackPanel Spacing="8">
                <Button x:Name="ImportStaffCsvButton" Content="職員一覧CSVを取り込む" Click="OnImportStaffCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ExportStaffCsvButton" Content="職員一覧CSVを書き出す" Click="OnExportStaffCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ImportWishesCsvButton" Content="希望シフトCSVを取り込む" Click="OnImportWishesCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ExportWishesCsvButton" Content="希望シフトCSVを書き出す" Click="OnExportWishesCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ImportConstraintsCsvButton" Content="各制約CSVを取り込む" Click="OnImportConstraintsCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ExportConstraintsCsvButton" Content="各制約CSVを書き出す" Click="OnExportConstraintsCsvClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ImportRosterButton" Content="名簿CSVを新規データとして取り込む"
                        Click="OnImportRosterClick" HorizontalAlignment="Stretch" />
            </StackPanel>

            <TextBlock Text="ログ" Style="{StaticResource MagiTitleSmallTextStyle}" Margin="0,8,0,0" />
            <StackPanel Spacing="8">
                <Button x:Name="ExportLogsButton" Content="操作ログを書き出す（テキスト）" Click="OnExportLogsClick" HorizontalAlignment="Stretch" />
                <Button x:Name="ExportLogsJsonButton" Content="操作ログを書き出す（JSON）" Click="OnExportLogsJsonClick" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
