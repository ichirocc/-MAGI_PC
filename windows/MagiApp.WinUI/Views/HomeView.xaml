<UserControl
    x:Class="MagiApp.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] 「ホーム」タブの最初の実装。Kotlin原本の思考誘導ホーム（OperatorNextActionCard 等、
      MagiDashboardCards.kt）の本格移植ではなく、現在の状態（読込済みか・満足度・直近メッセージ・
      必須/合計違反）を読取専用で示す最小版。「勤務表をつくる」導線は既存の RunV6FullOptimize
      （フェーズ9ピース9で移植済み・テスト済み）へ直接委譲する。
      「バックグラウンドで計算」（Phase 10 の RunInBackground）は 3.698.0 で SettingsView へ移した。

      [2026-09-02, 配線] 「初期解生成（賢い版）」(GenerateSmartInitial)・「仕上げ最適化」
      (RunSoftPolish)・「他の案」の適用(ApplyAlternative)は、いずれもフェーズ9で移植・テスト済みの
      ViewModel APIだったがこの画面から一度も呼べなかった（RunV6FullOptimize/RunInBackground/Stopの
      3つしか導線が無かった）。3ボタンとも RunV6FullOptimize と同じ Ui.Loaded &amp;&amp; !Ui.Running の
      表示上の抑止で並べる（実際の可否判定は各APIが内部で行う二重防御、既存ボタンと同じ方針）。
      「他の案」は Portfolio(複数案並列探索)実行後にだけ Ui.Alternatives が埋まるため、0件のときは
      節ごと隠す。

      [phase9 #2] 処方箋カード（Kotlin原本 OperatorNextActionCard, 3.480.0/3.483.0）＝状態（未作成／完成／
      埋められない／もう少し）で見出し・大ボタン・補助ボタンが変わる 1 枚と、「AIの解決提案」
      （旧 SmartActionCard の「この手を使う」は 3.643.0 で主カードの補助ボタンへ統合）。「初期解生成」ボタンは
      カード内の補助導線（下書きをつくる／下書きから作り直す）と重複するため撤去（Android の重複排除と同じ）。
      実行中の進捗表示（改善%・残り時間）は #3 で別途。

      [phase9 #3] 実行中の進捗行（Kotlin原本 progressSummary＝必須残り／要調整／残り時間）を処方箋カード内に、
      「途中経過を見る」（LiveScheduleCard＝色タイルの盤面、赤枠＝今回変化）を LiveCard として移植。

      [phase9 #4] コパイロット（Kotlin原本 CopilotCard）＝実現できない希望の警告／操作の助言／研磨の限界（要調整をもう少し減らせるか試す、3.683.0）。
      単独の「仕上げ最適化」ボタンは Android と同じくこのカード内のリンクへ統合。

      [phase9 #5] 空状態（Kotlin原本 EmptyStateCard）＝データ未読込のとき「データを開く／サンプルで試す／新規につくる（空から）」。
      通常は起動時にフィクスチャが自動で入るため、読込に失敗した・空にしたときの導線。読込中は補足を 1 文にして 3 つを押せなくする（3.698.0）。

      [Android 3.698.0] 主カードの区画は CellSheetLogic.HomeCardSectionsOf の並び（作成 → 見出し → 札 → 状態 2 行 → 主ボタン 1 つ → 補助 →
      ほかの問題 → 詳細 → でき具合 → ⓘ → 下書き。実行中は進捗だけ）。XAML はその正順で区画を置き、CodeBehind は区画ごとの表示と中身だけを決める。
      ページ見出し「ホーム」はシェルの上部バーが持つ。「勤務表をつくる／バックグラウンド／やめる」の 3 ボタンは主ボタンと下部バーに重複するので外し、
      背景実行は設定タブへ移した（主操作は画面に 1 つ、統合仕様 INV-09）。

      [phase9 #1] 「人員不足の原因」「人員過剰がなぜ減らないか」（Kotlin原本 CoverageDiagnosisCard）を
      同じ文言で移植。過剰枠の「希望固定N人」は CoverageSurplus.PinnedStaff を名指しし、ボタンで
      RemoveWish(i, day) を呼ぶ（Android 3.492.0）。診断が無い／不足も過剰も無いときは節ごと隠す。
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
            <Border x:Name="EmptyStateCard" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerLG}" Padding="24">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <FontIcon Glyph="&#xE787;" FontSize="44" Foreground="{StaticResource MagiPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitleText" Style="{StaticResource MagiTitleLargeTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitleText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MagiBodyMediumTextStyle}" Opacity="0.8" />
                    <Button x:Name="EmptyOpenButton" Content="データを開く" Click="OnEmptyOpenClick" HorizontalAlignment="Stretch" MinHeight="56"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="EmptySampleButton" Content="サンプルで試す" Click="OnEmptySampleClick" HorizontalAlignment="Stretch" MinHeight="56" />
                    <Button x:Name="EmptyNewButton" Content="新規につくる（空から）" Click="OnEmptyNewClick" HorizontalAlignment="Stretch" MinHeight="56" />
                </StackPanel>
            </Border>

            <Border x:Name="NextActionCard" CornerRadius="{StaticResource MagiCornerSM}" Padding="20">
                <StackPanel Spacing="14">
                    <!-- CREATION: 自動作成の結果（作成の完了＝配布できる、とは言わない）と、保存に失敗したときの「もう一度保存する」。 -->
                    <StackPanel x:Name="CreationHost" Spacing="2" />
                    <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" Style="{StaticResource MagiTitleLargeTextStyle}" FontWeight="Bold" />
                    <!-- BADGES: 必須は単位ごと、2 つ目は最優先の不足（INV-07）。 -->
                    <StackPanel x:Name="BadgeHost" Orientation="Horizontal" Spacing="8" />
                    <!-- STATUS: 2 行まで。探索中はカードの中の「やめる」。 -->
                    <StackPanel x:Name="StatusHost" Spacing="4" />
                    <Grid x:Name="ProgressRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="ProgressSpinner" Width="22" Height="22" IsActive="True" />
                        <TextBlock x:Name="ProgressText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Style="{StaticResource MagiBodyMediumTextStyle}" />
                    </Grid>
                    <!-- PRIMARY: 塗りの主ボタンは画面に 1 つ。 -->
                    <Button x:Name="BigButton" Click="OnBigClick" HorizontalAlignment="Stretch" MinHeight="56" Style="{StaticResource AccentButtonStyle}" />
                    <!-- HELPER: 段に補助が無ければ「表で全体を見る」。 -->
                    <Button x:Name="HelperButton" Click="OnHelperClick" HorizontalAlignment="Stretch" MinHeight="48" />
                    <HyperlinkButton x:Name="OthersButton" Click="OnOthersClick" MinHeight="48" />
                    <!-- DETAIL: 本文・注記・直した結果・CSV の保存状態・終わり方・緩める方法の探索。 -->
                    <StackPanel x:Name="DetailHost" Spacing="6">
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="OutcomeText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="SavedText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="StopText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Visibility="Collapsed" />
                        <Grid x:Name="RelaxSearchRow" Visibility="Collapsed" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="RelaxSearchText" Text="希望を変えずに、個人の上限0を例外で緩める方法を調べています…" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource MagiBodySmallTextStyle}" />
                            <HyperlinkButton x:Name="RelaxStopButton" Grid.Column="1" Content="やめる" MinHeight="44" Click="OnStopRelaxClick" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="SatisfactionHost" Spacing="6">
                        <TextBlock x:Name="ResolveText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" FontWeight="Bold" />
                        <ProgressBar x:Name="ResolveBar" Minimum="0" Maximum="100" MinHeight="8" />
                        <TextBlock x:Name="SoftNoteText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="InfoHost" Spacing="6">
                        <HyperlinkButton x:Name="DetailToggle" Click="OnDetailToggleClick" Padding="0" />
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                                   Text="※でき具合＝最初からの違反の減り具合（必須違反が残る間は最大55%）。結果は下書きに反映しました。「元に戻す」で取り消せます。確定は書き出すときです。" />
                    </StackPanel>
                    <HyperlinkButton x:Name="RedraftLink" Click="OnSmartInitialClick" HorizontalAlignment="Stretch"
                                     Content="下書きから作り直す（今の結果は「元に戻す」で戻せます）" />
                </StackPanel>
            </Border>

            <!-- [3.645.0/仕様 5.3] 相談してから決める判断の一覧（Kotlin ConsultCard）。主カードの「未確認事項 N 件」の中身。 -->
            <Border x:Name="ConsultCard" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="12" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ConsultTitle" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock Text="関係者に確認してから決める項目です。確認できたら「済」を押してください（アプリを閉じると消えます。書き出しは止めません）。" TextWrapping="Wrap" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="ConsultListHost" Spacing="4" />
                </StackPanel>
            </Border>

            <Border x:Name="LiveCard" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                <StackPanel Spacing="6">
                    <HyperlinkButton x:Name="LiveToggle" Click="OnLiveToggleClick" MinHeight="48" Content="途中経過を見る" />
                    <StackPanel x:Name="LivePanel" Spacing="6">
                        <TextBlock x:Name="LiveCaption" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LiveGridHost" Spacing="1" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="CopilotCard" Spacing="10">
                <Border x:Name="ImpossibleWishPanel" Background="{StaticResource MagiErrorContainerBrush}"
                        CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ImpossibleWishText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}"
                                   Foreground="{StaticResource MagiOnErrorContainerBrush}" />
                        <Button Content="希望シフトを編集" Click="OnEditWishesClick" MinHeight="48" />
                    </StackPanel>
                </Border>
                <Border x:Name="CopilotHintPanel" Background="{StaticResource MagiSecondaryContainerBrush}"
                        CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="CopilotHintText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}"
                                   Foreground="{StaticResource MagiOnSecondaryContainerBrush}" />
                        <Button Content="編集タブで見直す" Click="OnGoEditClick" MinHeight="48" />
                    </StackPanel>
                </Border>
                <Border x:Name="PolishPanel" Background="{StaticResource MagiTertiaryContainerBrush}"
                        CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                    <StackPanel Spacing="8">
                        <HyperlinkButton x:Name="SoftPolishButton" Click="OnSoftPolishClick" MinHeight="48"
                                         Foreground="{StaticResource MagiOnTertiaryContainerBrush}">
                            <TextBlock x:Name="SoftPolishLinkText" TextWrapping="Wrap" />
                        </HyperlinkButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CoveragePanel" Spacing="10">
                <StackPanel x:Name="ShortagePanel" Spacing="8">
                    <TextBlock Text="人員不足の原因" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock x:Name="ShortageHeadline" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="ShortageListHost" Spacing="8" />
                    <TextBlock x:Name="ShortageMoreText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                    <Border x:Name="RelaxationPanel" Background="{StaticResource MagiTertiaryContainerBrush}" CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="解けるようにするには（担当追加の案）" Style="{StaticResource MagiTitleSmallTextStyle}" />
                            <StackPanel x:Name="RelaxationListHost" Spacing="2" />
                            <TextBlock Text="※ 担当追加の提案です。設定は変えません。採用するときは編集タブ＞年間マスター①で担当を追加してください。"
                                       TextWrapping="Wrap" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SurplusPanel" Spacing="8">
                    <TextBlock Text="人員過剰がなぜ減らないか" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock x:Name="SurplusHeadline" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="SurplusListHost" Spacing="8" />
                    <TextBlock x:Name="SurplusMoreText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AlternativesPanel" Spacing="4">
                <TextBlock Text="他の案" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="AlternativesWorseText" TextWrapping="Wrap" FontSize="14" Opacity="0.8" />
                <TextBlock TextWrapping="Wrap" FontSize="14" Opacity="0.8"
                           Text="案を押すと、反映する前に確かめます（反映後も「元に戻す」で取り消せます）。" />
                <StackPanel x:Name="AlternativesListHost" Spacing="4" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
