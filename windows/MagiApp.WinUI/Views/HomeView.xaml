<UserControl
    x:Class="MagiApp.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ9] 「ホーム」タブの最初の実装。Kotlin原本の思考誘導ホーム（OperatorNextActionCard 等、
      MagiDashboardCards.kt）の本格移植ではなく、現在の状態（読込済みか・満足度・直近メッセージ・
      必須/合計違反）を読取専用で示す最小版。「勤務表をつくる」導線は既存の RunV6FullOptimize
      （フェーズ9ピース9で移植済み・テスト済み）へ直接委譲する。
      「バックグラウンドで計算」は Phase 10 で実装した RunInBackground（HomeView.xaml.cs 参照）。

      [2026-09-02, 配線] 「初期解生成（賢い版）」(GenerateSmartInitial)・「仕上げ最適化」
      (RunSoftPolish)・「他の案」の適用(ApplyAlternative)は、いずれもフェーズ9で移植・テスト済みの
      ViewModel APIだったがこの画面から一度も呼べなかった（RunV6FullOptimize/RunInBackground/Stopの
      3つしか導線が無かった）。3ボタンとも RunV6FullOptimize と同じ Ui.Loaded &amp;&amp; !Ui.Running の
      表示上の抑止で並べる（実際の可否判定は各APIが内部で行う二重防御、既存ボタンと同じ方針）。
      「他の案」は Portfolio(複数案並列探索)実行後にだけ Ui.Alternatives が埋まるため、0件のときは
      節ごと隠す。

      [phase9 #2] 処方箋カード（Kotlin原本 OperatorNextActionCard, 3.480.0/3.483.0）＝状態（未作成／完成／
      埋められない／もう少し）で見出し・大ボタン・補助ボタンが変わる 1 枚と、「AIの解決提案」
      （SmartActionCard＝分析タブと同じ改善提案の先頭候補を 1 ボタンで適用）。「初期解生成」ボタンは
      カード内の補助導線（下書きをつくる／下書きから作り直す）と重複するため撤去（Android の重複排除と同じ）。
      実行中の進捗表示（改善%・残り時間）は #3 で別途。

      [phase9 #3] 実行中の進捗行（Kotlin原本 progressSummary＝必須残り／気になる点／残り時間）を処方箋カード内に、
      「途中経過を見る」（LiveScheduleCard＝色タイルの盤面、赤枠＝今回変化）を LiveCard として移植。

      [phase9 #1] 「人員不足の原因」「人員過剰がなぜ減らないか」（Kotlin原本 CoverageDiagnosisCard）を
      同じ文言で移植。過剰枠の「希望固定N人」は CoverageSurplus.PinnedStaff を名指しし、ボタンで
      RemoveWish(i, day) を呼ぶ（Android 3.492.0）。診断が無い／不足も過剰も無いときは節ごと隠す。
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="ホーム" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13" Opacity="0.8" />

            <Border x:Name="NextActionCard" CornerRadius="{StaticResource MagiCornerSM}" Padding="20">
                <StackPanel Spacing="14">
                    <Border x:Name="PhaseBadge" CornerRadius="{StaticResource MagiCornerLG}" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock x:Name="PhaseText" Style="{StaticResource MagiLabelMediumTextStyle}" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" Style="{StaticResource MagiTitleLargeTextStyle}" FontWeight="Bold" />
                    <TextBlock x:Name="ResolveText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" FontWeight="Bold" />
                    <ProgressBar x:Name="ResolveBar" Minimum="0" Maximum="100" MinHeight="8" />
                    <HyperlinkButton x:Name="DetailToggle" Click="OnDetailToggleClick" Padding="0" />
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8"
                               Text="※解消度＝最初からの違反の減り具合（必須違反が残る間は最大55%）。結果は下書きに反映済み・「元に戻す」で取消可・確定は書き出し時です。" />
                    <Grid x:Name="ProgressRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="ProgressSpinner" Width="22" Height="22" IsActive="True" />
                        <TextBlock x:Name="ProgressText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Style="{StaticResource MagiBodyMediumTextStyle}" />
                    </Grid>
                    <Button x:Name="BigButton" Click="OnBigClick" HorizontalAlignment="Stretch" MinHeight="56" />
                    <Button x:Name="HelperButton" Click="OnHelperClick" HorizontalAlignment="Stretch" MinHeight="48" />
                    <HyperlinkButton x:Name="RedraftLink" Click="OnSmartInitialClick" HorizontalAlignment="Stretch"
                                     Content="下書きから作り直す（今の結果は「元に戻す」で戻せます）" />
                </StackPanel>
            </Border>

            <Border x:Name="LiveCard" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                <StackPanel Spacing="6">
                    <HyperlinkButton x:Name="LiveToggle" Click="OnLiveToggleClick" MinHeight="48" Content="途中経過を見る" />
                    <StackPanel x:Name="LivePanel" Spacing="6">
                        <TextBlock x:Name="LiveCaption" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LiveGridHost" Spacing="1" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="SmartActionCard" Background="{StaticResource MagiSecondaryContainerBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="AIの解決提案" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock x:Name="SmartStatusText" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" />
                    <StackPanel x:Name="SmartTopPanel" Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SmartKindBadge" CornerRadius="{StaticResource MagiCornerLG}" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="SmartKindText" Style="{StaticResource MagiLabelMediumTextStyle}" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="SmartLabelText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Style="{StaticResource MagiBodyMediumTextStyle}" />
                        </Grid>
                        <TextBlock x:Name="SmartDiffText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.85" />
                        <Button x:Name="SmartApplyButton" Content="この手を適用（推奨）" Click="OnSmartApplyClick" HorizontalAlignment="Stretch" MinHeight="52" />
                        <TextBlock x:Name="SmartMoreText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="MakeButton" Content="勤務表をつくる" Click="OnMakeClick" HorizontalAlignment="Stretch" />
            <Button x:Name="SoftPolishButton" Content="仕上げ最適化（今の勤務表をやさしく整える）"
                    Click="OnSoftPolishClick" HorizontalAlignment="Stretch" />
            <Button x:Name="BackgroundButton" Content="バックグラウンドで計算（ウィンドウを閉じると中断）" Click="OnBackgroundClick" HorizontalAlignment="Stretch" />
            <Button x:Name="StopButton" Content="やめる" Click="OnStopClick" HorizontalAlignment="Stretch" />

            <StackPanel x:Name="CoveragePanel" Spacing="10">
                <StackPanel x:Name="ShortagePanel" Spacing="8">
                    <TextBlock Text="人員不足の原因" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock x:Name="ShortageHeadline" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="ShortageListHost" Spacing="8" />
                    <TextBlock x:Name="ShortageMoreText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                    <Border x:Name="RelaxationPanel" Background="{StaticResource MagiTertiaryContainerBrush}" CornerRadius="{StaticResource MagiCornerSM}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="解けるようにするには（担当追加の案）" Style="{StaticResource MagiTitleSmallTextStyle}" />
                            <StackPanel x:Name="RelaxationListHost" Spacing="2" />
                            <TextBlock Text="※ 担当追加の提案です。設定変更は行いません（採否はご判断ください）。"
                                       TextWrapping="Wrap" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SurplusPanel" Spacing="8">
                    <TextBlock Text="人員過剰がなぜ減らないか" Style="{StaticResource MagiTitleMediumTextStyle}" />
                    <TextBlock x:Name="SurplusHeadline" TextWrapping="Wrap" Style="{StaticResource MagiBodyMediumTextStyle}" Opacity="0.8" />
                    <StackPanel x:Name="SurplusListHost" Spacing="8" />
                    <TextBlock x:Name="SurplusMoreText" TextWrapping="Wrap" Style="{StaticResource MagiBodySmallTextStyle}" Opacity="0.8" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AlternativesPanel" Spacing="4">
                <TextBlock Text="他の案" FontSize="16" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="Portfolio(並列複数案)実行で見つかった採用案以外の候補。適用すると今の勤務表を置き換えます。" />
                <StackPanel x:Name="AlternativesListHost" Spacing="4" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
