<UserControl
    x:Class="MagiApp.WinUI.Views.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagiApp.WinUI.Views">

    <!--
      [フェーズ8→9] 「勤務表」タブ。S×T が可変でセルごとに違反色分けが要る。
      [2026-09-11, ItemsView化] マトリックス本体（ScheduleItemsView）は Microsoft.UI.Xaml.Controls.ItemsView
      （StackLayout・仮想化対応）＋データバインディングで組む（ScheduleGridModels.cs の
      ScheduleRowVm/ScheduleCellVm、ScheduleView.xaml.cs の RenderSchedule 参照）。行(職員)を
      ItemsView が仮想化し、行内の日セルは ItemsRepeater（横方向 StackLayout、列数が小さいため
      仮想化不要）で並べる。RenderSchedule は行・セルのコレクション自体は使い回し、値だけを
      書き換える（ItemsSource を毎回差し替えるとスクロール位置を失うため）。Kotlin原本
      MagiScheduleViews.kt（1594行、ScheduleGrid/StaffCalendarCard/TallyCard 等）のうち
      シフト集計（TallyCard＝職員別・日別）は最小版のまま従来どおり Grid 直組み（RenderStaffTally/
      RenderDayTally 参照、このItemsView化の対象外）。
      セルタップで担当可能シフトの一覧から選んで編集できる（ScheduleView.xaml.cs の
      ShowCellEditor/MagiViewModel.SetCell 参照）。違反ハイライト（枠色）・希望バッジ・
      分析タブからの違反箇所ジャンプ（FocusCell）は実装済み（クラスKDoc参照）。
      「元に戻す/やり直す」は MagiViewModel.Undo/Redo（Kotlin原本と同じ最大30段のスタック）へ配線。
      「まとめて割当」は複数セルへの一括代入（ScheduleView.xaml.cs の OnBulkAssignClick/MagiViewModel.SetCells 参照）。
      [phase9 #10] シフト別の人員不足サマリー 1 行（Kotlin原本 ScheduleGrid 冒頭、3.116.0）＝covU のある日数をシフト別に多い順。
      日ヘッダの「▼N」（その日の不足人数、Ui.V6.DayRisks）も同じ「人員」バケツ配下で表示。
      [phase9 #8] 検索・凡例の折りたたみ（Kotlin原本 SearchLegendBar, 既定=閉）＝職員名検索（該当行の名前を青太字、行は隠さない）＋
      違反の凡例（WinUI の枠は実線の色分けなので色で説明）＋シフトの色凡例（記号チップ）。
      [phase9 #7] 違反の種別フィルタ（Kotlin原本 ViolationFilterBar/VioBuckets, E7）＝6 バケツの件数付きトグルで
      セル枠・集計枠・違反日を絞る（表示のみ）。「集中」は違反・未反映希望以外のセルを淡色化。VioBuckets は MagiApp.ViewModels。
      [phase9 #6] 画面下固定のナビバー（Kotlin原本 ScheduleNavBar, 3.481.0/3.483.0）＝前週/次週の横スクロールジャンプ・
      違反のある日の巡回（日ヘッダを約2.5秒強調）。セルをタップした行の職員名と列の日付も約2.5秒強調（3.444.0 クロスハイライト）。
    -->
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="UndoButton" Content="元に戻す" Click="OnUndoClick" />
            <Button x:Name="RedoButton" Content="やり直す" Click="OnRedoClick" />
            <Button x:Name="BulkAssignButton" Content="まとめて割当" Click="OnBulkAssignClick" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap" />
            <Border x:Name="FilterBar" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="12,8">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilterTitle" VerticalAlignment="Center" Style="{StaticResource MagiTitleSmallTextStyle}" Opacity="0.8" />
                        <HyperlinkButton x:Name="ShowAllButton" Grid.Column="1" Content="すべて表示" Click="OnShowAllVioClick" />
                        <ToggleButton x:Name="FocusToggle" Grid.Column="2" Content="集中" Click="OnFocusToggleClick" />
                    </Grid>
                    <StackPanel x:Name="BucketChips" Orientation="Horizontal" Spacing="6" />
                </StackPanel>
            </Border>
            <Border x:Name="ShortageBanner" Background="{StaticResource MagiErrorContainerBrush}"
                    CornerRadius="{StaticResource MagiCornerXS}" Padding="10,6">
                <TextBlock x:Name="ShortageBannerText" TextWrapping="Wrap" Style="{StaticResource MagiLabelMediumTextStyle}"
                           Foreground="{StaticResource MagiOnErrorContainerBrush}" />
            </Border>
            <Border x:Name="SearchLegendBar" Background="{StaticResource MagiSurfaceVariantBrush}"
                    CornerRadius="{StaticResource MagiCornerSM}" Padding="12,8">
                <StackPanel Spacing="8">
                    <HyperlinkButton x:Name="SearchLegendToggle" Click="OnSearchLegendToggleClick" Padding="0" HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Left" />
                    <StackPanel x:Name="SearchLegendPanel" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="職員名で検索（該当行を強調）" TextChanged="OnSearchTextChanged" />
                            <Button x:Name="SearchClearButton" Grid.Column="1" Content="消す" Click="OnSearchClearClick" />
                        </Grid>
                        <StackPanel x:Name="ViolationLegendHost" Orientation="Horizontal" Spacing="16" />
                        <TextBlock x:Name="ShiftLegendTitle" Text="シフトの色" Style="{StaticResource MagiLabelMediumTextStyle}" Opacity="0.8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ShiftLegendHost" Orientation="Horizontal" Spacing="6" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer x:Name="GridScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ViewChanged="OnGridScrollViewChanged">
            <StackPanel Spacing="20">
                <ItemsView x:Name="ScheduleItemsView" SelectionMode="None" IsItemInvokedEnabled="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0" />
                    </ItemsView.Layout>
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="local:ScheduleRowVm">
                            <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:ScheduleCellVm">
                                        <Border Background="{x:Bind Background, Mode=OneWay}"
                                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                                CornerRadius="6"
                                                Margin="1"
                                                Padding="6,4,6,4"
                                                MinWidth="{x:Bind MinWidth, Mode=OneWay}"
                                                Opacity="{x:Bind Opacity, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"
                                                Tapped="OnScheduleCellTapped"
                                                PointerPressed="OnScheduleCellPointerPressed"
                                                PointerReleased="OnScheduleCellPointerReleased"
                                                PointerExited="OnScheduleCellPointerReleased"
                                                PointerCanceled="OnScheduleCellPointerReleased"
                                                Loaded="OnScheduleCellLoaded"
                                                Unloaded="OnScheduleCellUnloaded">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                           TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
                                                           FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                                                           Foreground="{x:Bind Foreground, Mode=OneWay}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <!-- [希望バッジ] 右下の丸。ShowWishDot でなく Visibility を直接持つ理由は
                                                     ScheduleGridModels.cs 参照（x:Bind の暗黙 bool→Visibility 変換に依存しない）。 -->
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{x:Bind WishDotColor, Mode=OneWay}"
                                                         Visibility="{x:Bind WishDotVisibility, Mode=OneWay}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Margin="0,0,2,2" />
                                                <!-- [押下フィードバック] コードビハインドが Children の末尾要素として直接
                                                     参照する（DataTemplate内のx:Nameはコードビハインドから素朴に
                                                     引けないため、インデックス参照の方が確実）。 -->
                                                <Rectangle Fill="Black" Opacity="0.25" Visibility="Collapsed" IsHitTestVisible="False"
                                                           RadiusX="6" RadiusY="6" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>

                <StackPanel Spacing="6">
                    <TextBlock Text="シフト集計（職員別）" Style="{StaticResource MagiTitleSmallTextStyle}" />
                    <Grid x:Name="StaffTallyGridHost" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="シフト集計（日別）" Style="{StaticResource MagiTitleSmallTextStyle}" />
                    <Grid x:Name="DayTallyGridHost" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="NavBar" Grid.Row="3" Background="{StaticResource MagiSurfaceVariantBrush}"
                CornerRadius="{StaticResource MagiCornerSM}" Padding="12,6">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrevWeekButton" Grid.Column="0" Content="◀週" Click="OnPrevWeekClick" MinHeight="48" />
                <Button x:Name="NextWeekButton" Grid.Column="1" Content="週▶" Click="OnNextWeekClick" MinHeight="48" />
                <TextBlock x:Name="NavLabel" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource MagiLabelLargeTextStyle}" Opacity="0.8" />
                <Button x:Name="PrevVioButton" Grid.Column="3" Content="◀違反" Click="OnPrevVioClick" MinHeight="48" />
                <Button x:Name="NextVioButton" Grid.Column="4" Content="違反▶" Click="OnNextVioClick" MinHeight="48" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
