<UserControl
    x:Class="MagiApp.WinUI.Views.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      [フェーズ8→9] 「勤務表」タブ。S×T が可変でセルごとに違反色分けが要るため XAML の静的
      テンプレートで表現しづらく、コードビハインドで Grid を組み立てる（ScheduleView.xaml.cs の
      RenderSchedule 参照）。Kotlin原本 MagiScheduleViews.kt（1594行、ScheduleGrid/StaffCalendarCard/
      TallyCard 等）の本格移植は今後の段階（ItemsRepeaterベース・違反フィルタ・週送り等）で行う。
      セルタップで担当可能シフトの一覧から選んで編集できる（ScheduleView.xaml.cs の
      ShowCellEditor/MagiViewModel.SetCell 参照）。違反ハイライト等の装飾は未移植。
    -->
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" FontSize="14" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ScheduleGridHost" />
        </ScrollViewer>
    </Grid>
</UserControl>
